# Use the free HTTPS domain assigned to your ngrok account, without a scheme.
APP_DOMAIN=replace-with-your-ngrok-domain.ngrok-free.dev
NGROK_AUTHTOKEN=replace-with-ngrok-authtoken

DB_NAME=chess
DB_USERNAME=chess
DB_PASSWORD=generated-by-scripts/prepare-deploy-env.sh
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

APP_JWT_SECRET=generated-by-scripts/prepare-deploy-env.sh
APP_ENGINE_JWT_SECRET=generated-by-scripts/prepare-deploy-env.sh
APP_INTERNAL_TOKEN=generated-by-scripts/prepare-deploy-env.sh
APP_ACCESS_TOKEN_TTL=PT15M
APP_REFRESH_TOKEN_TTL=P7D
APP_ROOM_TOKEN_TTL=PT2M
APP_GAME_START_TIMEOUT=PT2M
APP_INVITATION_TTL=PT5M
COOKIE_SAME_SITE=Strict

APP_S3_ENDPOINT=http://minio:9000
APP_S3_REGION=us-east-1
APP_S3_BUCKET=chess-files
APP_S3_ACCESS_KEY=generated-by-scripts/prepare-deploy-env.sh
APP_S3_SECRET_KEY=generated-by-scripts/prepare-deploy-env.sh
APP_S3_PATH_STYLE=true
APP_AVATAR_MAX_SIZE=5MB

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_EMAIL_FROM=chess@example.com

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
LOG_LEVEL=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0

CHESS_DISCONNECT_GRACE_SECONDS=60
CHESS_ROOM_START_TIMEOUT_SECONDS=120
