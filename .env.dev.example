SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_NAME=chess
DB_USERNAME=chess
DB_PASSWORD=chess-local-development-only
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

APP_FRONTEND_URL=http://localhost:5173
APP_ENGINE_WS_URL=ws://localhost:9002/ws/play
APP_CORS_ORIGINS=http://localhost:5173
APP_JWT_SECRET=local-dev-access-secret-please-replace-before-deploy-0001
APP_ENGINE_JWT_SECRET=local-dev-engine-secret-shared-with-chess-000001
APP_INTERNAL_TOKEN=local-dev-internal-secret-shared-with-chess-000001
APP_REDIS_SECRET=chess-local-redis-password
APP_STOMP_RELAY_PASSCODE=chess-local-rabbit-password
APP_STOMP_RELAY_LOGIN=chess
APP_ACCESS_TOKEN_TTL=PT15M
APP_REFRESH_TOKEN_TTL=P7D
APP_ROOM_TOKEN_TTL=PT2M
APP_GAME_START_TIMEOUT=PT2M
APP_INVITATION_TTL=PT5M
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

APP_STORAGE_PROVIDER=s3
APP_S3_REGION=us-east-1
APP_S3_BUCKET=chess-files
APP_S3_ACCESS_KEY=chess-local
APP_S3_SECRET_KEY=local-dev-minio-secret
APP_S3_PATH_STYLE=true
APP_AVATAR_MAX_SIZE=5MB

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_EMAIL_FROM=chess@localhost

GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
LOG_LEVEL=INFO

CHESS_HOST=0.0.0.0
CHESS_PORT=9002
CHESS_OUTBOX_DIR=/var/lib/chess/outbox
CHESS_DISCONNECT_GRACE_SECONDS=60
CHESS_ROOM_START_TIMEOUT_SECONDS=120

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://backend:8080
